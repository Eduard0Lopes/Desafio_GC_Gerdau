# segredos (a senha do banco fica aqui — use o .env.example como modelo)
.env
*.env.local

# IDE (configurações pessoais do IntelliJ/VS Code)
.idea/
*.iml
.vscode/

# dependências e builds (recriáveis com um comando)
node_modules/
target/
dist/
*.jar
*.class

# logs e temporários
logs/
*.log
tmp/
.DS_Store
Thumbs.db

# caches
__pycache__/
*.pyc
.cache/
