# =============================================================================
# Exemplo de configuração — copie para ".env" e ajuste.
# NÃO coloque credenciais reais neste arquivo (ele é versionado).
# =============================================================================

# ---------- Banco de dados ----------
# Padrão (sem definir): cluster de demonstração do projeto — "clone e rode".
# Para usar o Mongo local do Docker Compose, use a opção (A).
# (A) Mongo local (docker compose):
# MONGODB_URI=mongodb://localhost:27017/gerdau_prototipo
# (B) MongoDB Atlas (próprio):
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/gerdau_prototipo?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gerdau_prototipo
MONGODB_DATABASE=gerdau_prototipo

# ---------- Carga dos dados oficiais ----------
# Diretório das planilhas do Time de IA (somente leitura)
SEED_DIR=IA/data/processed
SEED_ENABLED=true

# ---------- Motor de similaridade ----------
SEARCH_ENGINE=local
SIMILARITY_ENFORCEMENT=enforce
SIMILARITY_LIMIAR_DUPLICIDADE=0.88
SIMILARITY_LIMIAR_ALERTA=0.70
SIMILARITY_SCORE_MINIMO=0.30

# ---------- Infraestrutura ----------
ENSURE_INDEXES=true
API_DOCS_ENABLED=true

# ---------- Segurança ----------
# Perfil de demonstração (headers X-Usuario-Id / X-Usuario-Papel).
# Em produção, use OIDC: identidade derivada do token autenticado (seção 13).
APP_MODO_DEMONSTRACAO=true
