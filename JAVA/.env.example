# =============================================================================
# Copie este arquivo para ".env" (cp .env.example .env) e preencha.
# NÃO coloque aspas nos valores. NUNCA suba o .env para o Git (já está no .gitignore).
# Guia completo: docs/COMO-RODAR.md   |   Conexão com o MongoDB: docs/CONECTAR-MONGODB.md
# =============================================================================

# ---------- 1) CONEXÃO COM O MONGODB (obrigatório) ----------
# Inclua o NOME DO BANCO depois da última barra. Escolha UMA das opções:
#
# (A) MongoDB Atlas  (senha com caracteres especiais precisa ser URL-encoded: @ -> %40, : -> %3A ...)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/NOME_DO_BANCO?retryWrites=true&w=majority
#
# (B) MongoDB rodando na SUA máquina (fora do Docker) — de dentro do container use host.docker.internal:
# MONGODB_URI=mongodb://host.docker.internal:27017/NOME_DO_BANCO
#
# (C) MongoDB local de teste, subido pelo próprio compose (perfil "local-db", já vem com dados de exemplo):
# MONGODB_URI=mongodb://root:troque-esta-senha-mongo@mongo:27017/gerdau_servicos?authSource=admin

# Só usado na opção (C):
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=troque-esta-senha-mongo

# ---------- 2) MOTOR DE BUSCA ----------
# local = funciona em QUALQUER MongoDB (regex). atlas = MongoDB Atlas Search (precisa criar os índices:
# mongosh "<MONGODB_URI>" scripts/mongo/create-atlas-search-indexes.js)
SEARCH_ENGINE=local

# ---------- 3) SEGURANÇA ----------
# Senha dos 4 usuários de demonstração (consultor, solicitante, admin.dados, admin.tecnico). Mínimo 8 caracteres.
APP_DEV_PASSWORD=troque-esta-senha

# ---------- 4) OPCIONAIS ----------
# Porta publicada no seu computador
BACKEND_PORT=8080
# observe = só registra similares (não bloqueia) | enforce = alerta/bloqueia conforme o documento
SIMILARITY_ENFORCEMENT=enforce
# Perfis Spring: json-logs (logs em JSON) | oidc (login corporativo por JWT). Combine com vírgula.
SPRING_PROFILES_ACTIVE=
# Swagger UI em /swagger-ui.html (desligue em produção)
API_DOCS_ENABLED=true
# Rode UMA vez com true se o seu banco legado não tem nomeNormalizado/descricaoNormalizada
BACKFILL_NORMALIZED=false
# false se o seu DBA gerencia os índices
ENSURE_INDEXES=true
