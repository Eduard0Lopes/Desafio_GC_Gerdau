<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="root-pane" spacing="16" fx:controller="br.com.gerdau.servicos.desktop.controller.CadastroController">
    <padding>
        <Insets top="16" right="24" bottom="16" left="24"/>
    </padding>

    <Label fx:id="userLabel" styleClass="muted"/>

    <StackPane VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="10" maxWidth="560" maxHeight="-Infinity" alignment="CENTER_LEFT">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <Label text="Cadastrar Novo Item" styleClass="title"/>

            <Label text="Tipo de Componente" styleClass="field-label"/>
            <ComboBox fx:id="tipoBox" maxWidth="Infinity"/>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="textoLabel" text="Descrição do item" styleClass="field-label"/>
                <Label fx:id="contadorLabel" styleClass="counter"/>
            </HBox>
            <TextField fx:id="textoField" promptText="Ex.: Manutenção mecânica normal"/>

            <Label fx:id="siglaLabel" text="Sigla" styleClass="field-label"/>
            <TextField fx:id="siglaField" promptText="Ex.: HR, UN, M2"/>

            <Label fx:id="inlineLabel" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="salvarButton" text="Salvar Cadastro" styleClass="primary" onAction="#onSalvar"/>
                <Button fx:id="verificarButton" text="Verificar Similaridade" styleClass="secondary" onAction="#onVerificar"/>
                <Button text="Voltar" styleClass="secondary" onAction="#onVoltar"/>
                <ProgressIndicator fx:id="spinner" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
            </HBox>
        </VBox>
    </StackPane>
</VBox>
