# =============================================================================
# Configuração do ambiente (copie de .env.example se precisar criar do zero)
# =============================================================================

# ---------- Banco de dados ----------
# Padrão: cluster Atlas do projeto — é o MESMO banco do "Mongo web"
# (qualquer cadastro feito no app aparece lá imediatamente).
# Para usar o Mongo local do Docker: MONGODB_URI=mongodb://mongo:27017/gerdau_prototipo
MONGODB_URI=mongodb+srv://gerdau_mvp_user:gerdaumvp2026@cluster0.fsmqcef.mongodb.net/gerdau_prototipo?retryWrites=true&w=majority
MONGODB_DATABASE=gerdau_prototipo

# ---------- Carga dos dados oficiais ----------
SEED_DIR=/app/dados-oficiais
SEED_ENABLED=true

# ---------- Motor de similaridade ----------
SEARCH_ENGINE=local
SIMILARITY_ENFORCEMENT=enforce
SIMILARITY_LIMIAR_DUPLICIDADE=0.88
SIMILARITY_LIMIAR_ALERTA=0.70
SIMILARITY_SCORE_MINIMO=0.30

# ---------- Infraestrutura ----------
ENSURE_INDEXES=true
API_DOCS_ENABLED=true
